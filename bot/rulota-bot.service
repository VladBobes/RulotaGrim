[Unit]
Description=Rulota Grim Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/RulotaGrim/bot
EnvironmentFile=/home/ubuntu/RulotaGrim/bot/.env
ExecStart=/usr/bin/node /home/ubuntu/RulotaGrim/bot/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
